# Salin ke .env.local (jangan di-commit). Kosongkan Supabase → app jalan dari seed/plan.json tanpa login.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: seed (laptop) dan cron (dibatasi ke akun OWNER_EMAIL). JANGAN pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=


# M5 (push + cron). Public key boleh ke client; private key server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Vercel Cron mengirim "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=

# Opsional (nonaktif secara default): integrasi Strava — lihat README.
# STRAVA_CLIENT_ID= STRAVA_CLIENT_SECRET= STRAVA_WEBHOOK_VERIFY_TOKEN= STRAVA_SUBSCRIPTION_ID=
