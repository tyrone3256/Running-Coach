# Salin ke .env.local (jangan di-commit). Kosongkan Supabase → app jalan dari seed/plan.json tanpa login.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Hanya untuk `npm run seed:supabase` di laptop. JANGAN pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=

# M4 (coach) — server only
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
