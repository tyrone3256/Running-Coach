# Salin ke .env.local (jangan di-commit). Kosongkan Supabase → app jalan dari seed/plan.json tanpa login.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only: seed (laptop) dan cron (dibatasi ke akun OWNER_EMAIL). JANGAN pernah diberi prefix NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
OWNER_EMAIL=

# M4 (coach) — server only. ANTHROPIC_MODEL opsional (default claude-opus-5-5)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# M5 (push + cron). Public key boleh ke client; private key server only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Vercel Cron mengirim "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=
